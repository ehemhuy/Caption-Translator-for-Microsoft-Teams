{
  "manifest_version": 3,
  "name": "Caption Translator for Microsoft Teams",
  "version": "0.1.0",
  "description": "Translate Microsoft Teams live captions using any OpenAI-compatible LLM (Ollama, OpenAI, LM Studio) or LibreTranslate.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": { "default_popup": "options.html", "default_icon": "icons/48.png" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
